# 一学期 OneTerm 环境变量配置模板
# 复制本文件为 .env 后按需修改

# 服务监听端口（默认 8789）
SERVER_PORT=8789

# 是否强制启用 Mock 模式（true 时强制走 Mock；false 时若存在系统环境变量或数据库配置则自动调用真实大模型）
ONETERM_MOCK=false

# -------------------------------------------------------------
# 大模型「双支持模式」配置（支持直接读取系统环境变量或在此处配置）
# -------------------------------------------------------------
# DeepSeek 密钥配置（支持 DEEPSEEK_API 或 DEEPSEEK_API_KEY）
DEEPSEEK_API=
# 可选：默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 可选：OpenAI / 兼容接口配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：独立的识图与向量模型配置（留空时自动回退或由 Mock 网关模拟）
VISION_API_KEY=
EMBEDDING_API_KEY=

# AES-256-GCM 加密数据库模型 API Key 的主密钥（生产环境请替换为随机 32 位以上强密钥）
ONETERM_SECRET_KEY=replace-with-your-32-byte-secret-key

# 首次启动自动创建的管理员账号与初始密码
ONETERM_ADMIN_USERNAME=admin
ONETERM_ADMIN_PASSWORD=replace-with-strong-admin-password

# SQLite 数据库文件存储路径
ONETERM_DB_PATH=./data/oneterm.db
